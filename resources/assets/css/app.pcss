@layer theme, base, components, utilities;

@import 'tailwindcss';
@import './partials/vars.pcss';
@import './partials/hack.pcss' layer(base);
@import './vendor/nprogress.pcss' layer(base);
@import './partials/skeleton.pcss' layer(base);
@import './partials/tooltip.pcss' layer(base);
@import './partials/context-menu.pcss' layer(base);
@import './partials/shared.pcss' layer(base);
@import './partials/scroll-mask.pcss';

@config "../../../tailwind.config.js";

@custom-variant no-hover (@media (hover: none));

/*
  The default border color has changed to `currentcolor` in Tailwind CSS v4,
  so we've added these compatibility styles to make sure everything still
  looks the same as it did with Tailwind CSS v3.

  If we ever want to remove these styles, we need to add an explicit border
  color utility to any element that depends on these defaults.
*/
@layer base {
  *,
  ::after,
  ::before,
  ::backdrop,
  ::file-selector-button {
    border-color: var(--color-gray-200, currentcolor);
  }
}

@utility playable-list-item {
  @apply rounded-md max-w-full! h-[64px] flex
    items-center transition-[background-color] ease-in-out duration-150
    focus-visible:outline-none focus-visible:ring-inset focus-visible:ring-1 focus-visible:ring-k-fg-30!
    hover:bg-k-fg-5;

  &.selected {
    @apply bg-k-fg-10;
  }
}

@utility animate-rise {
  animation: rise 0.5s var(--ease-out) backwards;
  animation-delay: calc(min(var(--stagger, 0), 10) * 55ms);
}

@utility animate-pop-in {
  animation: pop-in 0.4s var(--ease-out) backwards;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(14px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.92);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}
